# 하루(Haru) 운영 환경변수 — 실제 값은 절대 저장소에 커밋하지 않습니다.
# 사용법: cp .env.example .env && source로 읽지 말고, export 로 셸 환경에 주입하세요.

# Threads (graph.threads.net)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Instagram Graph API (graph.instagram.com)
IG_USER_ID=
IG_ACCESS_TOKEN=

# Telegram Bot API (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 링크 허브 (GitHub Pages) 기본 URL, 끝에 슬래시 없이
HUB_BASE_URL=https://haru.reviews
