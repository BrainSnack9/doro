  "cards": [
    {"group": 1, "group_until": 19.5, "t": 11.8, "name": "잡**", "date": "2026.05.04", "text": "왜 이렇게 많이 사는지 써보니 바로 이해된 가성비 전기요"},
    {"group": 1, "group_until": 19.5, "t": 14.6, "name": "오**", "date": "2026.10.07", "text": "가격이 너무 비싸지 않으면서도 기본적으로 따뜻하게 사용할 수 있는 제품"},
    {"group": 1, "group_until": 19.5, "t": 16.4, "name": "이*희", "date": "2026.10.04", "text": "작년에 처음 사용해보고 너무 만족해서 올해도 같은 제품으로 다시 구매했어요"},
    {"group": 2, "group_until": 28.3, "t": 20.6, "name": "윤*호", "date": "2026.10.05", "text": "일반 이불 정도의 얇은 두께에 쉽게 접어져 보관도 굉장히 편하더라구요"},
    {"group": 2, "group_until": 28.3, "t": 22.9, "name": "엄***", "date": "2026.09.13", "text": "배송해서 개봉하니, 마치 이불같네요"},
    {"group": 2, "group_until": 28.3, "t": 25.0, "kind": "summary", "name": "하루", "text": "대신 맨바닥에 깔면 쿠션감은 없다는 말이 같이 나옴. 침대 위나 요 밑은 괜찮다고"},
    {"group": 3, "group_until": 42.3, "t": 29.2, "kind": "summary", "name": "하루", "text": "별로·나쁨 4% (약 3천 명). 거의 다 온도 조절기 얘기"},
    {"group": 3, "group_until": 42.3, "t": 32.9, "kind": "summary", "name": "하루", "text": "그런데 긴 리뷰마다 꼭 들어 있는 한 줄: 저온화상 조심"},
    {"group": 3, "group_until": 42.3, "t": 36.0, "name": "윤*기", "date": "2026.10.19", "text": "강아지 오줌 공격에 결국 사망한 전기장판… 똑같은 제품으로 재구매했어요ㅋㅋ"},
    {"group": 3, "group_until": 42.3, "t": 39.8, "kind": "summary", "name": "하루", "text": "자기 전엔 타이머. 이건 리뷰 읽은 내 결론"}
  ]
